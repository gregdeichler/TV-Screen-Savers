<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://deichlers.example/familyclock"
        version="1.0.0" viewmodes="maximized">
    <tizen:application id="DCLR202611.familyclock" package="DCLR202611" required_version="4.0"/>
    <tizen:profile name="tv"/>
    <name>Deichlers Family Clock</name>
    <description>Offline minimalist family crest and live analog clock</description>
    <content src="index.html"/>
    <icon src="icon.svg"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable"
                   background-support="disable" encryption="disable"
                   hwkey-event="enable"/>
</widget>
